<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SailMonitor.PageSetup">

    <ScrollView Orientation="Vertical"
            VerticalScrollBarVisibility="Always">
        
        <Grid
    ColumnSpacing="10"
    RowSpacing="16"
    HorizontalOptions="Center"
            
    VerticalOptions="Start"
            
           HeightRequest="2000">

            <Grid.ColumnDefinitions>
                <!-- Left column: auto width -->
                <ColumnDefinition Width="Auto" />
                <!-- Right column: auto width unless it's a text entry -->
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- Row 0 -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 1 -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 2 -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 3 -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 4 -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 5 -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 6 -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 7 -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <HorizontalStackLayout  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                <Label 
           Text="Port:"
           HorizontalOptions="Start"
           VerticalOptions="Center" />

                
            <Entry 
           x:Name="Port"
           Keyboard="Numeric"
           Placeholder="Enter port"
           HorizontalOptions="End"
           WidthRequest="150"/>
                    <Label Text="Changing requires save and restart" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Row 1: Night Mode -->
            <HorizontalStackLayout Grid.Row="1" Grid.Column="0">

                <Label 
           Text="Night Mode:"
           VerticalOptions="Center" />

                <CheckBox 
              x:Name="Night"
              CheckedChanged="ToggleCheckBox"
              HorizontalOptions="End"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Row="1" Grid.Column="1">
                <Label 
           Text="Keep Active:"
           VerticalOptions="Center"/>

                <CheckBox
              x:Name="KeepActive"
                      CheckedChanged="ToggleCheckBox"
              HorizontalOptions="End"/>
            </HorizontalStackLayout>

           

            <!-- Row 4: Use GPS HEADING -->
            <HorizontalStackLayout Grid.Row="1" Grid.Column="1">

                <Label 
           Text="Use GPS HEADING:"
           VerticalOptions="Center"/>

            <CheckBox 
              x:Name="UseGPSHEADING"
                      CheckedChanged="ToggleCheckBox"
              HorizontalOptions="End"/>
                </HorizontalStackLayout>

            <!-- Row 3: Use GPS POS -->
            <HorizontalStackLayout Grid.Row="2" Grid.Column="0">
                <Label 
                    Text="Use GPS POS:"
                    VerticalOptions="Center"/>

                                    <CheckBox 
                       x:Name="UseGPSPOS"
                               CheckedChanged="ToggleCheckBox"
                       HorizontalOptions="End"/>
            </HorizontalStackLayout>

            <!-- Row 5: Use GPS SOG -->
            <HorizontalStackLayout Grid.Row="2" Grid.Column="1" >
                <Label 
               Text="Use GPS SOG:"
               VerticalOptions="Center"/>   

            <CheckBox 
              x:Name="UseGPSSOG"
                      CheckedChanged="ToggleCheckBox"
              HorizontalOptions="End"/>
                </HorizontalStackLayout>

            <!-- Row 6: Save Frequency -->
            <Label Grid.Row="3" Grid.Column="0"
           Text="Save Frequency:"
           VerticalOptions="Center"/>

            <Entry Grid.Row="3" Grid.Column="1"
           x:Name="SaveFrequency"
           Keyboard="Numeric"
           Placeholder="Enter frequency"
           WidthRequest="150"
           HorizontalOptions="End"/>

            <!-- Row 7: Wind Speed -->
                <Label Grid.Row="4" Grid.Column="0"
                Text="Depth:"
                VerticalOptions="Center"/>

                <VerticalStackLayout Grid.Row="4" Grid.Column="1">
                    
                    
                    <Border Stroke="Red"  
                    StrokeThickness="1" 
                    StrokeShape="Rectangle"
                    Padding="0">
                        <CollectionView x:Name="DepthList"
                            SelectionMode="Single"
                         HorizontalOptions="End"
                          SelectionChanged ="DepthChanged"
                          WidthRequest="200">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="2">
                                    <Label Text="{Binding}"
                                           Loaded="OnItemLabelLoadedDepth">

                                    <!--    <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroupList>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal">
                                                        <VisualState.Setters>
                                                            <Setter Property="TextColor" Value="Black" />
                                                        </VisualState.Setters>
                                                    </VisualState>

                                                    <VisualState x:Name="Selected">
                                                        <VisualState.Setters>
                                                            <Setter Property="TextColor" Value="Red" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateGroupList>
                                        </VisualStateManager.VisualStateGroups> -->
                                    </Label>
                                </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>

                <Label Grid.Row="5" Grid.Column="0"
                    Text="Speed:"
                    VerticalOptions="Center"/>

                <VerticalStackLayout Grid.Row="5" Grid.Column="1">
                    
                    <Border Stroke="Red"  
                        StrokeThickness="1" 
                        StrokeShape="RoundRectangle"
                        Padding="0">

                        <CollectionView x:Name="SpeedList"
                        SelectionMode="Single"
                         HorizontalOptions="End"
                          SelectionChanged ="SpeedChanged"
                          WidthRequest="200">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="2">
                                        <Label Text="{Binding}" 
                                           Loaded="OnItemLabelLoadedSpeed"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>

                <Label Grid.Row="6" Grid.Column="0"
           Text="Wind Speed:"
           VerticalOptions="Center"/>
            
                <VerticalStackLayout Grid.Row="6" Grid.Column="1">

                <Border Stroke="Red"  
                    StrokeThickness="1" 
                    StrokeShape="Rectangle"
                    Padding="0">

                    <CollectionView x:Name="WindSpeedList"
                SelectionMode="Single"
                                    HorizontalOptions="End"
                                     SelectionChanged ="WindSpeedChanged"
                                     WidthRequest="200">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="2">
                                        <Label Text="{Binding}" 
                                           Loaded="OnItemLabelLoadedWindSpeed"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout> 

            <!-- You can add controls on right side here later -->

            <!-- Row 8: Save Button -->
            <Button Grid.Row="7" Grid.ColumnSpan="2"
            Text="Save"
            HorizontalOptions="Center"
            Clicked="SaveButtonClicked"/>
        </Grid>
        
    </ScrollView>
</ContentView>

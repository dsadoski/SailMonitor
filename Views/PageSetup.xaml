<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SailMonitor.PageSetup">

    <ScrollView Orientation="Vertical"
            VerticalScrollBarVisibility="Always">
        <VerticalStackLayout>
        <Grid
    ColumnSpacing="10"
    RowSpacing="16"
    HorizontalOptions="Center"
    VerticalOptions="Start">

            <Grid.ColumnDefinitions>
                <!-- Left column: auto width -->
                <ColumnDefinition Width="Auto" />
                <!-- Right column: auto width unless it's a text entry -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- Row 0 -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 1 -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 2 -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 3 -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 4 -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 5 -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 6 -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 7 -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0"
           Text="Port:"
           HorizontalOptions="Start"
           VerticalOptions="Center" />

                <HorizontalStackLayout  Grid.Row="0" Grid.Column="1">
            <Entry 
           x:Name="Port"
           Keyboard="Numeric"
           Placeholder="Enter port"
           HorizontalOptions="End"
           WidthRequest="150"/>
                    <Label Text="Changing requires save and restart" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Row 1: Night Mode -->
            <Label Grid.Row="1" Grid.Column="0"
           Text="Night Mode:"
           VerticalOptions="Center" />

            <CheckBox Grid.Row="1" Grid.Column="1"
              x:Name="Night"
              CheckedChanged="ToggleCheckBox"
              HorizontalOptions="End"/>

            <!-- Row 2: Keep Active -->
            <Label Grid.Row="2" Grid.Column="0"
           Text="Keep Active:"
           VerticalOptions="Center"/>

            <CheckBox Grid.Row="2" Grid.Column="1"
              x:Name="KeepActive"
                      CheckedChanged="ToggleCheckBox"
              HorizontalOptions="End"/>

            <!-- Row 3: Use GPS POS -->
            <Label Grid.Row="3" Grid.Column="0"
           Text="Use GPS POS:"
           VerticalOptions="Center"/>

            <CheckBox Grid.Row="3" Grid.Column="1"
              x:Name="UseGPSPOS"
                      CheckedChanged="ToggleCheckBox"
              HorizontalOptions="End"/>

            <!-- Row 4: Use GPS HEADING -->
            <Label Grid.Row="4" Grid.Column="0"
           Text="Use GPS HEADING:"
           VerticalOptions="Center"/>

            <CheckBox Grid.Row="4" Grid.Column="1"
              x:Name="UseGPSHEADING"
                      CheckedChanged="ToggleCheckBox"
              HorizontalOptions="End"/>

            <!-- Row 5: Use GPS SOG -->
            <Label Grid.Row="5" Grid.Column="0"
           Text="Use GPS SOG:"
           VerticalOptions="Center"/>

            <CheckBox Grid.Row="5" Grid.Column="1"
              x:Name="UseGPSSOG"
                      CheckedChanged="ToggleCheckBox"
              HorizontalOptions="End"/>

            <!-- Row 6: Save Frequency -->
            <Label Grid.Row="6" Grid.Column="0"
           Text="Save Frequency:"
           VerticalOptions="Center"/>

            <Entry Grid.Row="6" Grid.Column="1"
           x:Name="SaveFrequency"
           Keyboard="Numeric"
           Placeholder="Enter frequency"
           WidthRequest="150"
           HorizontalOptions="End"/>

            <!-- Row 7: Wind Speed -->
                <Label Grid.Row="7" Grid.Column="0"
                Text="Depth:"
                VerticalOptions="Center"/>

                <VerticalStackLayout Grid.Row="7" Grid.Column="1">
                    <Button  x:Name="Depthbutton"
             Text="Unit"
             
             Clicked="Depthbutton_Clicked"
                  HorizontalOptions="End"/>
                    
                    <Border Stroke="Red"  
                    StrokeThickness="2" 
                    StrokeShape="Rectangle"
                    Padding="0">
                        <CollectionView x:Name="DepthList"
                            SelectionMode="Single"
                         HorizontalOptions="End"
                          SelectionChanged ="DepthChanged"
                          WidthRequest="200">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10">
                                        <Label Text="{Binding}"
                                           Loaded="OnItemLabelLoadedDepth"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>

                <Label Grid.Row="8" Grid.Column="0"
                    Text="Speed:"
                    VerticalOptions="Center"/>

                <VerticalStackLayout Grid.Row="8" Grid.Column="1">
                    <Button  x:Name="Speedbutton"
             Text="Unit"
             
             Clicked="Speedbutton_Clicked"
                  HorizontalOptions="End"/>
                    <Border Stroke="Red"  
StrokeThickness="2" 
StrokeShape="Rectangle"
Padding="0">

                        <CollectionView x:Name="SpeedList"
     SelectionMode="Single"
                         HorizontalOptions="End"
                          SelectionChanged ="SpeedChanged"
                          WidthRequest="200">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10">
                                        <Label Text="{Binding}" 
                                           Loaded="OnItemLabelLoadedSpeed"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>

                <Label Grid.Row="9" Grid.Column="0"
           Text="Wind Speed:"
           VerticalOptions="Center"/>
            
                <VerticalStackLayout Grid.Row="9" Grid.Column="1">
                    <Button  x:Name="WindSpeedbutton"
                        Text="Unit"
                        
                        Clicked="WindSpeedbutton_Clicked"
                             HorizontalOptions="End"/>
                    <Border Stroke="Red"  
StrokeThickness="2" 
StrokeShape="Rectangle"
Padding="0">

                        <CollectionView x:Name="WindSpeedList"
                SelectionMode="Single"
                                    HorizontalOptions="End"
                                     SelectionChanged ="WindSpeedChanged"
                                     WidthRequest="200">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10">
                                        <Label Text="{Binding}" 
                                           Loaded="OnItemLabelLoadedWindSpeed"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout> 

            <!-- You can add controls on right side here later -->

            <!-- Row 8: Save Button -->
            <Button Grid.Row="10" Grid.ColumnSpan="2"
            Text="Save"
            HorizontalOptions="Center"
            Clicked="SaveButtonClicked"/>
        </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>

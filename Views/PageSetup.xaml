<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SailMonitor.PageSetup">
    <ScrollView x:Name="SetupScroll" HorizontalScrollBarVisibility="Never">
        <Grid x:Name="SetupRoot" Padding="12" RowSpacing="12" ColumnSpacing="12">
            <Grid.GestureRecognizers>
                <SwipeGestureRecognizer Direction="Left" Swiped="OnSwipeLeft" />
                <SwipeGestureRecognizer Direction="Right" Swiped="OnSwipeRight" />
            </Grid.GestureRecognizers>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="NetworkCard" Grid.Row="0" Grid.Column="0" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="NMEA / UDP" FontSize="18" FontAttributes="Bold" />
                    <Label Text="Listen for NMEA 0183 data from your navigation system or NMEA gateway." FontSize="12" Opacity="0.72" />
                    <Grid ColumnDefinitions="*,150" ColumnSpacing="12">
                        <Label Text="Listen Port" VerticalOptions="Center" />
                        <Entry x:Name="Port" Grid.Column="1" Keyboard="Numeric" HorizontalTextAlignment="End" />
                    </Grid>
                    <Label Text="Changing the port requires Save Settings and an app restart." FontSize="11" Opacity="0.65" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="UnitsCard" Grid.Row="1" Grid.Column="0" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Units" FontSize="18" FontAttributes="Bold" />
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,170" RowSpacing="8" ColumnSpacing="12">
                        <Label Grid.Row="0" Text="Depth" VerticalOptions="Center" />
                        <Picker x:Name="DepthPicker" Grid.Row="0" Grid.Column="1" SelectedIndexChanged="UnitPickerChanged" />
                        <Label Grid.Row="1" Text="Speed" VerticalOptions="Center" />
                        <Picker x:Name="SpeedPicker" Grid.Row="1" Grid.Column="1" SelectedIndexChanged="UnitPickerChanged" />
                        <Label Grid.Row="2" Text="Wind Speed" VerticalOptions="Center" />
                        <Picker x:Name="WindSpeedPicker" Grid.Row="2" Grid.Column="1" SelectedIndexChanged="UnitPickerChanged" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border x:Name="DisplayCard" Grid.Row="2" Grid.Column="0" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Display" FontSize="18" FontAttributes="Bold" />
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10">
                        <VerticalStackLayout Grid.Row="0" Spacing="1">
                            <Label Text="Night Mode" />
                            <Label Text="Marine red theme for low-light use" FontSize="11" Opacity="0.65" />
                        </VerticalStackLayout>
                        <Switch x:Name="Night" Grid.Row="0" Grid.Column="1" Toggled="ToggleSwitch" />
                        <VerticalStackLayout Grid.Row="1" Spacing="1">
                            <Label Text="Keep Screen Awake" />
                            <Label Text="Prevents the display from sleeping while SailMonitor is running" FontSize="11" Opacity="0.65" />
                        </VerticalStackLayout>
                        <Switch x:Name="KeepActive" Grid.Row="1" Grid.Column="1" Toggled="ToggleSwitch" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border x:Name="GpsCard" Grid.Row="3" Grid.Column="0" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="GPS Options" FontSize="18" FontAttributes="Bold" />
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10">
                        <Label Grid.Row="0" Text="Use GPS Position" VerticalOptions="Center" />
                        <Switch x:Name="UseGPSPOS" Grid.Row="0" Grid.Column="1" Toggled="ToggleSwitch" />
                        <Label Grid.Row="1" Text="Use GPS Heading" VerticalOptions="Center" />
                        <Switch x:Name="UseGPSHEADING" Grid.Row="1" Grid.Column="1" Toggled="ToggleSwitch" />
                        <Label Grid.Row="2" Text="Use GPS SOG" VerticalOptions="Center" />
                        <Switch x:Name="UseGPSSOG" Grid.Row="2" Grid.Column="1" Toggled="ToggleSwitch" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border x:Name="LoggingCard" Grid.Row="4" Grid.Column="0" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Data Logging" FontSize="18" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,150" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="Save Frequency" />
                            <Label Text="Seconds between saved samples" FontSize="11" Opacity="0.65" />
                        </VerticalStackLayout>
                        <Entry x:Name="SaveFrequency" Grid.Column="1" Keyboard="Numeric" HorizontalTextAlignment="End" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button x:Name="SaveButton" Grid.Row="5" Grid.Column="0" Text="Save Settings" FontAttributes="Bold"
                    HeightRequest="50" CornerRadius="10" Clicked="SaveButtonClicked" />
        </Grid>
    </ScrollView>
</ContentView>

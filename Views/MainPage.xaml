<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SailMonitor.MainPage">
    <Grid x:Name="MainLayout" Padding="8" RowSpacing="8" RowDefinitions="Auto,*">
        <Grid.GestureRecognizers>
            <SwipeGestureRecognizer Direction="Left" Swiped="OnSwipeLeft" />
            <SwipeGestureRecognizer Direction="Right" Swiped="OnSwipeRight" />
        </Grid.GestureRecognizers>
        <!-- A separate measured row reserves the toolbar's space on every platform. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*" ColumnSpacing="8" ZIndex="1">
            <Button x:Name="PrevButton" Grid.Column="0" Text="◀ Prev" Clicked="Prev_Clicked"
                    MinimumHeightRequest="48" Padding="6,8" CornerRadius="9" FontSize="16" />
            <Button x:Name="NextButton" Grid.Column="1" Text="Next ▶" Clicked="Next_Clicked"
                    MinimumHeightRequest="48" Padding="6,8" CornerRadius="9" FontSize="16" />
            <Button x:Name="NightModeButton" Grid.Column="2" Clicked="NightMode_Clicked"
                    MinimumHeightRequest="48" Padding="6,8" CornerRadius="9" FontSize="16" />
        </Grid>
        <ContentView x:Name="content" Grid.Row="1" HorizontalOptions="Fill" VerticalOptions="Fill">
            <ContentView.GestureRecognizers>
                <SwipeGestureRecognizer Direction="Left" Swiped="OnSwipeLeft" />
                <SwipeGestureRecognizer Direction="Right" Swiped="OnSwipeRight" />
            </ContentView.GestureRecognizers>
        </ContentView>
    </Grid>
</ContentPage>
